[Unit]
Description=Hermes Observation Service V1
Documentation=https://github.com/ManlyRedfish/manlyredfish-ai-country/issues/81
After=network.target

[Service]
Type=simple
User=hermes-observer
Group=hermes-observer

# Separate Environment & Credential File
EnvironmentFile=/etc/hermes-observation/env
# HERMES_OBSERVATION_KEY=obs-secret-token-here
# HERMES_GENERIC_KEY_FINGERPRINT=sha256-fingerprint-of-generic-api-server-key
# HERMES_OBSERVATION_HOST=127.0.0.1
# HERMES_OBSERVATION_PORT=8643
# HERMES_OBSERVATION_LOG_MAX_ENTRIES=1000

ExecStart=/usr/bin/python3 -m gateway.observation_service

Restart=on-failure
RestartSec=5s

# Bounded Journal / Logging Restrictions
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

# Process & Capabilities Restrictions
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes

# Filesystem Restrictions
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/
ReadWritePaths=/var/log/hermes-observation

# Network Restrictions (Loopback egress only)
IPAddressAllow=127.0.0.1/32 ::1/128
IPAddressDeny=any
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
